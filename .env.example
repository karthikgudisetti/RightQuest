# Local (SQLite)
DATABASE_URL="file:./dev.db"

# Production / Vercel — Neon Postgres example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-refresh-in-production"
PORT=4000

# Optional live AI tutor
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Comma-separated extra CORS origins (custom domain)
CORS_ORIGIN=

# Frontend (set in Vercel if API is on another host)
# VITE_API_URL=https://your-app.vercel.app/api/v1
